import axios from 'axios';

// Cria a instância do Axios com a URL base da API do Laravel
const api = axios.create({
  baseURL: import.meta.env.VITE_API_URL || 'http://localhost:8000/api',
  headers: {
    'Content-Type': 'application/json',
    'Accept': 'application/json'
  }
});

/**
 * 1. LISTAR PRODUTOS (GET)
 * @param {Object} params - Parâmetros opcionais como page, search, etc.
 */
export async function fetchProducts(params = {}) {
  const response = await api.get('/products', { params });
  return response.data;
}

/**
 * 2. CADASTRAR NOVO PRODUTO (POST)
 * @param {Object} productData - Objeto contendo { name, description, brand, price, stock }
 */
export async function createProduct(productData) {
  const response = await api.post('/products', productData);
  return response.data;
}

/**
 * 3. EDITAR / ATUALIZAR PRODUTO (PUT)
 * @param {Number|String} id - ID do produto a ser editado
 * @param {Object} productData - Objeto com os dados atualizados
 */
export async function updateProduct(id, productData) {
  const response = await api.put(`/products/${id}`, productData);
  return response.data;
}

/**
 * 4. EXCLUIR PRODUTO (DELETE)
 * @param {Number|String} id - ID do produto a ser excluído
 */
export async function deleteProduct(id) {
  const response = await api.delete(`/products/${id}`);
  return response.data;
}

export default api;

<script setup>
import { ref, onMounted } from 'vue';
import { 
  fetchProducts, 
  createProduct, 
  updateProduct, 
  deleteProduct 
} from './services/api';

const produtos = ref([]);
const carregando = ref(false);

// 1. Carregar lista de produtos
const carregarProdutos = async () => {
  carregando.value = true;
  try {
    const resposta = await fetchProducts();
    produtos.value = resposta.data; // Formato padrão do Resource do Laravel
  } catch (erro) {
    console.error('Erro ao listar produtos:', erro);
  } finally {
    carregando.value = false;
  }
};

// 2. Salvar (Criar novo produto)
const salvarNovoProduto = async () => {
  const novoProduto = {
    name: 'Tinta Acrílica Branca',
    description: 'Lata 18L fosca',
    brand: 'Suvinil',
    price: 289.90,
    stock: 25
  };

  try {
    await createProduct(novoProduto);
    await carregarProdutos(); // Recarrega a lista
  } catch (erro) {
    console.error('Erro ao cadastrar produto:', erro);
  }
};

// 3. Atualizar produto existente
const atualizarProduto = async (id) => {
  const dadosAtualizados = {
    name: 'Tinta Acrílica Branca Premium',
    description: 'Lata 18L fosca lavável',
    brand: 'Suvinil',
    price: 310.00,
    stock: 20
  };

  try {
    await updateProduct(id, dadosAtualizados);
    await carregarProdutos();
  } catch (erro) {
    console.error('Erro ao editar produto:', erro);
  }
};

// 4. Remover produto
const removerProduto = async (id) => {
  try {
    await deleteProduct(id);
    await carregarProdutos();
  } catch (erro) {
    console.error('Erro ao excluir produto:', erro);
  }
};

onMounted(() => {
  carregarProdutos();
});
</script>
