{
CREATE TABLE produtos (
    id INT AUTO_INCREMENT PRIMARY KEY,
    nome VARCHAR(100) NOT NULL,
    descricao TEXT,
    marca VARCHAR(50) NOT NULL,
    preco DECIMAL(10, 2) NOT NULL,
    estoque INT NOT NULL DEFAULT 0,
    criado_em TIMESTAMP DEFAULT CURRENT_TIMESTAMP
);

-- Inserindo um único produto
INSERT INTO produtos (nome, descricao, marca, preco, estoque) 
VALUES ('Furadeira Impacto', 'Furadeira elétrica 750W 110V', 'Bosch', 359.90, 15);

-- Inserindo múltiplos produtos
INSERT INTO produtos (nome, descricao, marca, preco, estoque) 
VALUES 
    ('Tinta Acrílica Branca', 'Lata de tinta fosca 18L', 'Suvinil', 289.00, 30),
    ('Cimento CP II', 'Saco de cimento 50kg', 'Votoran', 38.50, 100);

-- Listar todos os produtos
SELECT * FROM produtos;

-- Listar apenas produtos em estoque com preço formatado
SELECT id, nome, marca, preco, estoque 
FROM produtos 
WHERE estoque > 0 
ORDER BY nome ASC;

-- Buscar produto específico por ID
SELECT * FROM produtos WHERE id = 1;

-- Atualizar preço e estoque de um produto específico
UPDATE produtos 
SET preco = 339.90, 
    estoque = 20 
WHERE id = 1;

-- Atualizar descrição e marca
UPDATE produtos 
SET descricao = 'Furadeira elétrica 750W 220V', 
    marca = 'Bosch Pro' 
WHERE id = 1;

-- Excluir um produto por ID
DELETE FROM produtos 
WHERE id = 1;

-- Excluir produtos com estoque zerado
DELETE FROM produtos 
WHERE estoque = 0;
}
